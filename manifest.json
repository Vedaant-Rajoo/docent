{
  "manifest_version": 3,
  "name": "Docent for YouTube",
  "version": "0.1.0",
  "description": "A minimal YouTube layout with an icon rail and native panels that open when you need them.",
  "icons": { "128": "icons/icon128.png" },
  "permissions": ["storage"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Disable Docent" },
  "options_ui": { "page": "settings.html", "open_in_tab": true },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["bridge.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["docent.js"],
      "css": ["docent.css"],
      "world": "MAIN",
      "run_at": "document_start"
    }
  ]
}
